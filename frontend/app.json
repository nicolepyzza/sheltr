{
  "expo": {
    "name": "Sheltr",
    "slug": "sheltr",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#E07A5F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sheltr.app",
      "config": {
        "googleMapsApiKey": ""
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Sheltr needs your location to help track and report lost pets in your area.",
        "NSPhotoLibraryUsageDescription": "Sheltr needs access to your photos to upload pictures of pets."
      }
    },
    "android": {
      "package": "com.sheltr.app",
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router"
    ],
    "scheme": "sheltr",
    "extra": {
      "apiUrl": "http://localhost:3000",
      "eas": {
        "projectId": "your-project-id"
      }
    }
  }
}
